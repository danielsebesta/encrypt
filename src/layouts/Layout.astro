---
import AsciiBackground from '../components/AsciiBackground.svelte';
import '../styles/global.css'

import { getTranslations, t, languages, locales, getLocalePath, pickDict, type Locale } from '../lib/i18n';
import CommandPalette from '../components/CommandPalette.svelte';
import { languageChoiceHref } from '../lib/locale';
import { getNavCategories, chatIcon, sendIcon, decryptIcon, whiteboardIcon } from '../lib/tools';
import Icon from '../components/Icon.astro';
import { REPO_SLUG, REPO_URL } from '../lib/repo';
import { getGithubStars } from '../lib/githubStars';
import { PRODUCT_NAME, siteName, siteOrigin } from '../lib/siteBrand';

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  mainClass?: string;
};

const backgroundMode = 'ascii' as 'ascii' | 'flow';
const locale = (Astro.currentLocale ?? 'en') as Locale;
const dict = getTranslations(locale);
const site = siteOrigin();
const brand = siteName();

const {
  title = t(dict, 'meta.defaultTitle'),
  description = t(dict, 'meta.defaultDescription'),
  ogImage = new URL('/og.png?v=9', site).href,
  canonical,
  mainClass = '',
} = Astro.props;

const path = Astro.url.pathname;
const cleanPath = getLocalePath(path, 'en');
const canonicalUrl = canonical || new URL(cleanPath, site).href;
const localePrefix = '';
const homeHref = '/';
const navCategories = getNavCategories(t, dict, localePrefix);
const paletteDict = pickDict(dict, ['nav', 'palette'], ['security.h1', 'install.h1', 'licenses.h1']);
const enableIntegrityCheck = import.meta.env.PROD;
const integrityRepository = REPO_SLUG;
const repoUrl = REPO_URL;
const githubStars = await getGithubStars(integrityRepository);
/** Display-cased site URL for social/search snippets; canonical stays lowercase. */
const brandUrl = (() => {
	try {
		const u = new URL(canonicalUrl);
		if (u.hostname.toLowerCase() !== 'encrypt.click') return u.href;
		// URL.hostname always lowercases; build the string so snippets can show Encrypt.click.
		return `https://Encrypt.click${u.pathname}${u.search}${u.hash}`;
	} catch {
		return canonicalUrl;
	}
})();
const siteJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: brand,
	...(brand === PRODUCT_NAME ? { alternateName: ['encrypt.click', 'Encrypt'] } : {}),
	url: site.replace(/\/$/, '') + '/',
	description,
};

const languageOptions = locales.map(l => ({
  code: l,
  name: languages[l].name,
  href: cleanPath,
  choose: languageChoiceHref(l, cleanPath),
  active: l === locale
}));

const primaryLinks = [
  { href: `${localePrefix}/share`, label: t(dict, 'nav.send'), icon: sendIcon },
  { href: `${localePrefix}/u`, label: t(dict, 'nav.decrypt'), icon: decryptIcon },
  { href: `${localePrefix}/chat`, label: t(dict, 'nav.chat'), icon: chatIcon },
  { href: `${localePrefix}/whiteboard`, label: t(dict, 'nav.whiteboard'), icon: whiteboardIcon },
];

const isCurrent = (href: string) => path === href || path === `${href}/`;
---

<!doctype html>
<html lang={locale} class="notranslate">
	<head>
		<meta charset="UTF-8" />
		<style>.theme-instant,.theme-instant *,.theme-instant *::before,.theme-instant *::after{transition:none!important;animation:none!important}</style>
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="google" content="notranslate" />
		<meta name="format-detection" content="telephone=no" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="application-name" content={brand} />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={brandUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale" content={locale} />
		<meta property="og:site_name" content={brand} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#08110a" media="(prefers-color-scheme: dark)" />
		{backgroundMode === 'ascii' && <link rel="preload" as="image" href="/flow-ascii-src.webp" fetchpriority="low" />}
		{backgroundMode === 'flow' && <link rel="preload" as="fetch" href="/flow-bg-dark.svg" crossorigin fetchpriority="low" media="(prefers-color-scheme: dark)" />}
		{backgroundMode === 'flow' && <link rel="preload" as="fetch" href="/flow-sweep-dark.svg" crossorigin fetchpriority="low" media="(prefers-color-scheme: dark)" />}
		{backgroundMode === 'flow' && <link rel="preload" as="fetch" href="/flow-bg-light.svg" crossorigin fetchpriority="low" media="(prefers-color-scheme: light)" />}
		{backgroundMode === 'flow' && <link rel="preload" as="fetch" href="/flow-sweep-light.svg" crossorigin fetchpriority="low" media="(prefers-color-scheme: light)" />}
		<meta name="color-scheme" content="light dark" />
		<meta name="robots" content="index, follow" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content={brand} />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="describedby" href="/llms.txt" />
		<script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />
		<link rel="preload" href="/fonts/google-sans-flex-latin.woff2" as="font" type="font/woff2" crossorigin />
		{enableIntegrityCheck && <script is:inline src="/integrity-check.js" defer></script>}
		{/* Theme before first paint — inlined so it is not a render-blocking network request. */}
		<script is:inline>
			(function () {
				var root = document.documentElement;
				root.classList.add('theme-instant');
				try {
					var t = localStorage.getItem('theme');
					var d = t === 'dark' || (!t && matchMedia('(prefers-color-scheme:dark)').matches);
					if (d) root.classList.add('dark');
					root.style.colorScheme = d ? 'only dark' : 'only light';
				} catch (e) {}
				requestAnimationFrame(function () {
					requestAnimationFrame(function () {
						root.classList.remove('theme-instant');
					});
				});
			})();
		</script>
	</head>
	<body>
		{backgroundMode === 'flow' ? (
			<div class="flow-bg" aria-hidden="true"><div class="flow-bg__base"></div><div class="flow-bg__sw flow-bg__sw--x"><div class="flow-bg__img"></div></div><div class="flow-bg__sw flow-bg__sw--y"><div class="flow-bg__img"></div></div></div>
		) : (
			<div class="flow-bg flow-bg--ascii" aria-hidden="true"><AsciiBackground client:load /></div>
		)}
		<a href="#main" class="skip-link">{t(dict, 'nav.skip')}</a>
		<header class="site-header">
			<div
				id="integrity-alert"
				class="integrity-alert hidden"
				data-repo={integrityRepository}
				data-asset-title={t(dict, 'integrity.assetTitle')}
				data-asset-message={t(dict, 'integrity.assetMessage')}
				data-deployed-label={t(dict, 'integrity.deployedLabel')}
				data-repo-label={t(dict, 'integrity.repoLabel')}
				role="alert"
			>
				<div class="mx-auto flex max-w-6xl items-start gap-3 px-4 py-3">
					<div class="integrity-alert__icon" aria-hidden="true">
						<Icon name="triangle-exclamation-point" size={20} />
					</div>
					<div class="min-w-0 flex-1">
						<p class="integrity-alert__title" data-integrity-title></p>
						<p class="integrity-alert__message" data-integrity-message></p>
						<div class="integrity-alert__links" data-integrity-links></div>
					</div>
					<button class="btn-ghost btn-sm btn-icon" type="button" aria-label={t(dict, 'integrity.dismissLabel')} data-integrity-dismiss>
						<Icon name="x" />
					</button>
				</div>
			</div>

			<nav id="site-nav" class="nav" aria-label={t(dict, 'nav.menu')}>
				<a href={homeHref} class="nav__brand">
					<img src="/encryptclick_icon.svg" alt="" width="24" height="36" class="h-9 w-auto" decoding="async" />
					<span>{PRODUCT_NAME}</span>
				</a>

				<div id="nav-links" class="nav__links">
					{primaryLinks.map((link) => (
						<a href={link.href} class="nav__link" aria-current={isCurrent(link.href) ? 'page' : undefined}>
							<Icon name={link.icon} class="nav__icon" />
							{link.label}
						</a>
					))}
					{navCategories.map((cat, i) => (
						<div class="nav__group">
							<button type="button" class="nav__link" aria-expanded="false" aria-controls={`nav-menu-${i}`} data-menu-toggle>
								<Icon name={cat.icon} class="nav__icon" />
								{cat.name}
								<Icon name="chevron-down" class="nav__chevron" />
							</button>
							<div id={`nav-menu-${i}`} class="menu">
								{cat.tools.map((tool) => (
									<a href={tool.href} class="menu__item" aria-current={isCurrent(tool.href) ? 'page' : undefined}>
										<Icon name={tool.icon} class="nav__icon" />
										{tool.label}
									</a>
								))}
							</div>
						</div>
					))}
				</div>

				<div class="nav__actions">
					<a href={repoUrl} target="_blank" rel="noopener noreferrer" class="btn-ghost btn-icon nav__github" aria-label={t(dict, 'nav.github')} title="GitHub">
						<Icon name="github" size={20} />
					</a>
					<CommandPalette client:idle locale={locale} dict={paletteDict} />
					<button id="theme-toggle" type="button" class="btn-ghost btn-icon" aria-label={t(dict, 'nav.toggleTheme')} aria-pressed="false">
						<Icon name="moon" size={20} class="dark:hidden" />
						<Icon name="sun" size={20} class="hidden dark:block" />
					</button>
					<div class="nav__group">
						<button type="button" class="nav__link nav__lang" aria-label={t(dict, 'nav.language')} aria-expanded="false" aria-controls="nav-menu-lang" data-menu-toggle>
							<Icon name="languages" size={20} />
							<Icon name="chevron-down" class="nav__chevron" />
						</button>
						<div id="nav-menu-lang" class="menu menu--end">
							{languageOptions.map((lang) => (
								<a href={lang.choose} rel="nofollow" class="menu__item" aria-current={lang.active ? 'page' : undefined} lang={lang.code}>
									<span class="menu__code">{lang.code}</span>
									{lang.name}
								</a>
							))}
						</div>
					</div>
					<button id="nav-toggle" type="button" class="btn-ghost btn-icon nav__burger" aria-label={t(dict, 'nav.menu')} aria-expanded="false" aria-controls="nav-links">
						<Icon name="menu" size={20} class="nav__burger-open" />
						<Icon name="x" size={20} class="nav__burger-close" />
					</button>
				</div>
			</nav>
		</header>

		<div
			id="pwa-notice"
			class="pwa-notice hidden"
			role="status"
			data-desktop={t(dict, 'pwa.notice.desktop')}
			data-install-ios={t(dict, 'pwa.notice.installIos')}
			data-install-android={t(dict, 'pwa.notice.installAndroid')}
		>
			<img class="app-shot app-shot--xs pwa-notice__shot" src="/screenshot-hub-chats.png?v=9" alt="" width="52" height="113" decoding="async" />
			<div class="pwa-notice__body min-w-0 flex-1">
				<p data-pwa-notice-text></p>
				<a class="pwa-notice__cta" href={`${localePrefix}/install`}>{t(dict, 'pwa.notice.cta')}</a>
			</div>
			<button type="button" class="btn-primary btn-sm hidden" data-pwa-install>{t(dict, 'pwa.promo.install')}</button>
			<button type="button" class="btn-ghost btn-sm" data-pwa-notice-dismiss>{t(dict, 'pwa.notice.dismiss')}</button>
		</div>

		<main id="main" class={`flex-1 ${mainClass}`} tabindex="-1">
			<slot />
		</main>

		<footer class="site-footer">
			<div id="pwa-promo" class="pwa-promo hidden">
				<div class="pwa-promo__inner">
					<div class="pwa-promo__shots" aria-hidden="true">
						<img class="app-shot app-shot--sm" src="/screenshot-hub-chats.png?v=9" alt="" width="72" height="156" decoding="async" />
						<img class="app-shot app-shot--sm" src="/screenshot-android-hub-settings.png?v=9" alt="" width="72" height="156" decoding="async" />
					</div>
					<div class="pwa-promo__copy min-w-0 flex-1">
						<p class="pwa-promo__eyebrow">{PRODUCT_NAME}</p>
						<p class="pwa-promo__title">{t(dict, 'pwa.promo.title')}</p>
						<p class="pwa-promo__text">{t(dict, 'pwa.promo.text')}</p>
						<ul class="platform-pills platform-pills--compact" aria-label={t(dict, 'pwa.platforms.label')}>
							<li class="platform-pill">{t(dict, 'pwa.platforms.ios')}</li>
							<li class="platform-pill">{t(dict, 'pwa.platforms.android')}</li>
						</ul>
						<p class="hidden pwa-promo__hint" data-pwa-hint-ios>{t(dict, 'pwa.promo.ios')}</p>
						<p class="hidden pwa-promo__hint" data-pwa-hint-menu>{t(dict, 'pwa.promo.menu')}</p>
						<div class="pwa-promo__actions">
							<button type="button" class="btn-primary btn-sm hidden" data-pwa-install>{t(dict, 'pwa.promo.install')}</button>
							<a class="btn-secondary btn-sm" href={`${localePrefix}/install`}>{t(dict, 'pwa.promo.how')}</a>
							<button type="button" class="btn-ghost btn-sm" data-pwa-promo-dismiss>{t(dict, 'pwa.promo.dismiss')}</button>
						</div>
					</div>
				</div>
			</div>
			<div class="site-footer__inner">
				<a href={homeHref} class="nav__brand">
					<img src="/encryptclick_icon.svg" alt="" width="14" height="22" class="h-[22px] w-auto" decoding="async" />
					<span class="text-sm">{PRODUCT_NAME}</span>
				</a>
				<div class="site-footer__links">
					<a href={`${localePrefix}/u`}>{t(dict, 'home.footer.decrypt')}</a>
					<a href={`${localePrefix}/install`}>{t(dict, 'home.footer.install')}</a>
					<a href={`${localePrefix}/security`}>{t(dict, 'home.footer.security')}</a>
					<a href="mailto:hello@encrypt.click">{t(dict, 'home.footer.contact')}</a>
					<a href={repoUrl} target="_blank" rel="noopener noreferrer">
						<Icon name="github" />GitHub
						{githubStars !== null && <span class="site-footer__stars"><Icon name="star" />{githubStars.toLocaleString('en')}</span>}
					</a>
					<a href={`${localePrefix}/licenses`}>{t(dict, 'home.footer.credits')}</a>
					<span>
						{t(dict, 'home.footer.builtBy')} <a href="https://sebesta.dev" target="_blank" rel="noopener noreferrer" class="text-text">Daniel Šebesta</a>
					</span>
				</div>
			</div>
		</footer>
		<script is:inline src="/ui.js?v=flow-v7" defer></script>
		<script is:inline src="/pwa.js?v=pwa-v4" defer></script>
	</body>
</html>
