---
import { t, type Locale } from '../../lib/i18n';
import { tools } from '../../lib/tools';

type Props = {
  locale: Locale;
  dict: Record<string, string>;
};

const { dict } = Astro.props;
const localePrefix = Astro.props.locale === 'en' ? '' : `/${Astro.props.locale}`;
const firstSentence = (text: string) => text.split(/(?<=[.!?])\s+(?=\p{Lu})/u)[0];
const items = tools.map((tool) => ({
  label: t(dict, tool.navLabelKey),
  text: firstSentence(t(dict, `${tool.i18nPrefix}.subtitle`)),
  href: `${localePrefix}/tools/${tool.slug}`,
  icon: tool.icon,
}));
---

<section id="home-tools" aria-labelledby="home-tools-title">
  <h2 id="home-tools-title" class="section-title">{t(dict, 'home.tools.title')}</h2>
  <p class="hint mt-1">{t(dict, 'home.tools.subtitle')}</p>

  <ul class="home-tools__grid">
    {items.map((tool) => (
      <li>
        <a href={tool.href} class="home-tools__card">
          <span class="home-tools__icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><Fragment set:html={tool.icon} /></svg>
          </span>
          <span class="home-tools__body">
            <span class="home-tools__label">{tool.label}</span>
            <span class="home-tools__text">{tool.text}</span>
          </span>
          <svg class="home-tools__arrow" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
        </a>
      </li>
    ))}
  </ul>
</section>
