---
import { t, type Locale } from '../../lib/i18n';
import { getNavCategories } from '../../lib/tools';

type Props = {
  locale: Locale;
  dict: Record<string, string>;
};

const { dict } = Astro.props;
const localePrefix = Astro.props.locale === 'en' ? '' : `/${Astro.props.locale}`;
const categories = getNavCategories(t, dict, localePrefix);
---

<section id="home-tools" aria-labelledby="home-tools-title">
  <h2 id="home-tools-title" class="section-title">{t(dict, 'home.tools.title')}</h2>
  <p class="hint mt-1">{t(dict, 'home.tools.subtitle')}</p>

  {categories.map((cat) => (
    <div>
      <h3 class="home-tools__name">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={cat.icon} /></svg>
        {cat.name}
      </h3>
      <ul class="home-tools__grid">
        {cat.tools.map((tool) => (
          <li>
            <a href={tool.href} class="home-tools__card">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="home-tools__icon"><Fragment set:html={tool.icon} /></svg>
              {tool.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</section>
