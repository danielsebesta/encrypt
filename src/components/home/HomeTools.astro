---
import { t, type Locale } from '../../lib/i18n';
import { tools } from '../../lib/tools';
import Icon from '../Icon.astro';

type Props = {
  locale: Locale;
  dict: Record<string, string>;
};

const { dict } = Astro.props;
const firstSentence = (text: string) => text.split(/(?<=[.!?])\s+(?=\p{Lu})/u)[0];
const taskSlugs = ['steganography', 'photo-cipher', 'time-capsule', 'spectral-cipher', 'chat-cipher'];
const tasks = taskSlugs.map((slug, i) => ({
  label: t(dict, `home.tools.tasks.${i + 1}`),
  href: `/experiments/${slug}`,
}));
const items = tools.map((tool) => ({
  label: t(dict, tool.navLabelKey),
  text: firstSentence(t(dict, `${tool.i18nPrefix}.subtitle`)),
  href: `/experiments/${tool.slug}`,
  icon: tool.icon,
}));
---

<section id="home-tools" aria-labelledby="home-tools-title">
  <div class="home-section__head">
    <h2 id="home-tools-title" class="section-title">{t(dict, 'home.tools.title')}</h2>
    <p class="hint">{t(dict, 'home.tools.subtitle')}</p>
  </div>

  <ul class="home-tools__grid panel panel--flush">
    {items.map((tool) => (
      <li>
        <a href={tool.href} class="home-tools__card">
          <Icon name={tool.icon} size={20} class="home-tools__icon" />
          <span class="home-tools__body">
            <span class="home-tools__label">{tool.label}</span>
            <span class="home-tools__text">{tool.text}</span>
          </span>
          <Icon name="arrow-right" class="home-tools__arrow" />
        </a>
      </li>
    ))}
  </ul>

  <div class="home-tools__tasks panel">
    <h3 class="home-tools__tasks-title">{t(dict, 'home.tools.tasks.title')}</h3>
    <ul class="home-tools__tasks-list">
      {tasks.map((task) => (
        <li>
          <a href={task.href}>
            <Icon name="chevron-right" />
            <span>{task.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
