---
import UltimateEncrypt from '../tools/UltimateEncrypt.svelte';
import ChatCreate from '../tools/ChatCreate.svelte';
import { pickDict, t, type Locale } from '../../lib/i18n';

type Props = {
  locale: Locale;
  dict: Record<string, string>;
};

const { locale, dict } = Astro.props;
const encryptDict = pickDict(dict, ['tools.ultimateEncrypt', 'common']);
const chatDict = pickDict(dict, ['chat', 'common']);

const features = [
  'home.hero.feature.encrypt',
  'home.hero.feature.chat',
  'home.hero.feature.calls',
  'home.hero.feature.files',
  'home.hero.feature.open',
] as const;
---

<section class="home-hero-section">
  <div class="max-w-5xl mx-auto px-5 relative z-1">

    <div class="text-center mb-10 md:mb-12">
      <img
        src="/encrypt_lock.svg"
        alt=""
        width="96"
        height="128"
        class="mx-auto w-16 md:w-24 h-auto mb-5"
        decoding="async"
      />
      <h1 class="text-3xl md:text-5xl lg:text-6xl leading-[1.08] tracking-[-0.04em] font-black text-zinc-950 dark:text-zinc-50">
        {t(dict, 'home.hero.title.line1')}{' '}
        <span class="lp-hero__title-accent">{t(dict, 'home.hero.title.line2')}</span>
      </h1>
      <p class="mt-4 max-w-2xl mx-auto text-base md:text-lg leading-7 text-zinc-600 dark:text-zinc-300">
        {t(dict, 'home.hero.subtitle')}
      </p>

      <ul class="home-hero-features" aria-label={t(dict, 'home.hero.featuresLabel')}>
        {features.map((key) => (
          <li>{t(dict, key)}</li>
        ))}
      </ul>

      <div class="home-hero-ctas">
        <a href="#home-encrypt" class="home-hero-cta home-hero-cta--primary">
          {t(dict, 'home.hero.ctaEncrypt')}
        </a>
        <a href="#home-chat" class="home-hero-cta home-hero-cta--secondary">
          {t(dict, 'home.hero.ctaChat')}
        </a>
        <a href="#home-tools" class="home-hero-cta home-hero-cta--secondary">
          {t(dict, 'home.hero.ctaTools')}
        </a>
      </div>

      <p class="mt-4 text-sm text-zinc-600 dark:text-zinc-400">
        {t(dict, 'home.hero.note')}
      </p>
    </div>

    <div class="home-hero-panels">

      <div id="home-encrypt" class="home-tool-panel">
        <div class="flex items-center gap-2 mb-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-500" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <p class="text-base font-bold text-zinc-800 dark:text-zinc-200">{t(dict, 'home.hero.panelTitle')}</p>
        </div>
        <p class="text-sm text-zinc-600 dark:text-zinc-400 mb-4 leading-relaxed">
          {t(dict, 'home.hero.panelEncryptLead')}
        </p>
        <div class="home-tool-panel__surface">
          <UltimateEncrypt client:idle locale={locale} dict={encryptDict} />
        </div>

        <div class="home-how-it-works">
          <p class="home-how-title">{t(dict, 'encrypt.howItWorks')}</p>
          <div class="home-how-steps">
            <div class="home-how-step">
              <span class="home-how-num">1</span>
              <span>{t(dict, 'encrypt.howStep1')}</span>
            </div>
            <div class="home-how-step">
              <span class="home-how-num">2</span>
              <span>{t(dict, 'encrypt.howStep2')}</span>
            </div>
            <div class="home-how-step">
              <span class="home-how-num">3</span>
              <span>{t(dict, 'encrypt.howStep3')}</span>
            </div>
          </div>
        </div>
      </div>

      <div id="home-chat" class="home-tool-panel">
        <div class="flex items-center gap-2 mb-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-500" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
          <p class="text-base font-bold text-zinc-800 dark:text-zinc-200">{t(dict, 'chat.pageTitle')} <span class="text-emerald-600 dark:text-emerald-400">{t(dict, 'chat.pageTitleHighlight')}</span></p>
        </div>
        <p class="text-sm text-zinc-600 dark:text-zinc-400 mb-4 leading-relaxed">
          {t(dict, 'home.hero.panelChatLead')}
        </p>
        <ChatCreate client:idle locale={locale} dict={chatDict} />

        <div class="home-how-it-works">
          <p class="home-how-title">{t(dict, 'home.hero.chatIncludesTitle')}</p>
          <div class="home-how-steps">
            <div class="home-how-step">
              <span class="home-how-num">1</span>
              <span>{t(dict, 'home.hero.chatIncludes1')}</span>
            </div>
            <div class="home-how-step">
              <span class="home-how-num">2</span>
              <span>{t(dict, 'home.hero.chatIncludes2')}</span>
            </div>
            <div class="home-how-step">
              <span class="home-how-num">3</span>
              <span>{t(dict, 'home.hero.chatIncludes3')}</span>
            </div>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>
