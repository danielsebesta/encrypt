---
import Layout from '../../../layouts/Layout.astro';
import Quiz from '../../../components/tools/Quiz.svelte';
import { getTranslations, t, type Locale } from '../../../lib/i18n';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const dict = getTranslations(locale);
const { id } = Astro.params;

export const prerender = false;
---

<Layout
  title={t(dict, 'quiz.meta.roomTitle')}
  description={t(dict, 'quiz.meta.roomDescription')}
>
  <div class="max-w-5xl mx-auto px-3 py-6 md:py-10">
    <Quiz client:only="svelte" roomId={id || 'default'} locale={locale} />
  </div>
</Layout>
