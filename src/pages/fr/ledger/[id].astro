---
import Layout from '../../../layouts/Layout.astro';
import Ledger from '../../../components/tools/Ledger.svelte';
import { getTranslations, t, type Locale } from '../../../lib/i18n';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const dict = getTranslations(locale);
const { id } = Astro.params;

export const prerender = false;
---

<Layout
  title={t(dict, 'ledger.meta.roomTitle')}
  description={t(dict, 'ledger.meta.roomDescription')}
>
  <div class="max-w-5xl mx-auto px-3 py-6 md:py-10">
    <div class="mb-4 text-center">
      <h1 class="text-2xl md:text-3xl font-bold tracking-tight mb-2">
        {t(dict, 'ledger.pageTitle')} <span class="text-emerald-500">{t(dict, 'ledger.pageTitleHighlight')}</span>
      </h1>
      <p class="text-xs text-zinc-400 dark:text-zinc-500">{t(dict, 'ledger.roomSubtitle')}</p>
    </div>
    <Ledger client:only="svelte" roomId={id || 'default'} locale={locale} />
  </div>
</Layout>
