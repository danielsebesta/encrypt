---
import Layout from '../../../layouts/Layout.astro';
import Whiteboard from '../../../components/tools/Whiteboard.svelte';
import { getTranslations, t, pickDict, type Locale } from '../../../lib/i18n';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const dict = getTranslations(locale);
const clientDict = pickDict(dict, ['whiteboard', 'common']);
const { id } = Astro.params;

export const prerender = false;
---

<Layout
  title={t(dict, 'whiteboard.meta.roomTitle')}
  description={t(dict, 'whiteboard.meta.roomDescription')}
>
  <div class="max-w-6xl mx-auto px-3 py-6 md:py-10">
    <div class="mb-4 text-center">
      <h1 class="text-2xl md:text-3xl font-bold tracking-tight mb-2">
        {t(dict, 'whiteboard.pageTitle')} <span class="text-emerald-500">{t(dict, 'whiteboard.pageTitleHighlight')}</span>
      </h1>
      <p class="text-xs text-zinc-400 dark:text-zinc-500">
        {t(dict, 'whiteboard.roomSubtitle')}
      </p>
    </div>
    <Whiteboard client:only="svelte" roomId={id || 'default'} locale={locale} dict={clientDict} />
  </div>
</Layout>
