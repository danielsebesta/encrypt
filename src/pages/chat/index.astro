---
import Layout from '../../layouts/Layout.astro';
import ToolAbout from '../../components/tools/ToolAbout.astro';
import ChatCreate from '../../components/tools/ChatCreate.svelte';
import { getTranslations, t, pickDict, type Locale } from '../../lib/i18n';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const dict = getTranslations(locale);
const clientDict = pickDict(dict, ['chat', 'common']);

export const prerender = true;
---

<Layout
  title={t(dict, 'chat.meta.createTitle')}
  description={t(dict, 'chat.meta.createDescription')}
>
  <div class="page page--narrow">
    <header class="page-head">
      <h1 class="page-title">{t(dict, 'chat.pageTitle')}</h1>
      <p class="page-lead">{t(dict, 'chat.pageSubtitle')}</p>
    </header>
    <div class="panel">
      <ChatCreate client:idle locale={locale} dict={clientDict} />
    </div>
    <ToolAbout dict={dict} prefix="chat" />
  </div>
</Layout>
