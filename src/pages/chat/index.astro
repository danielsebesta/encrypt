---
import Layout from '../../layouts/Layout.astro';
import ChatCreate from '../../components/tools/ChatCreate.svelte';
import ToolHelp from '../../components/tools/ToolHelp.svelte';
import { getTranslations, t, pickDict, type Locale } from '../../lib/i18n';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const dict = getTranslations(locale);
const clientDict = pickDict(dict, ['chat', 'tools.help', 'common']);
const chatHelpSections = ['what', 'messages', 'calls', 'files', 'safe', 'watchOut'];

export const prerender = true;
---

<Layout
  title={t(dict, 'chat.meta.createTitle')}
  description={t(dict, 'chat.meta.createDescription')}
>
  <div class="page page--narrow">
    <header class="page-head">
      <h1 class="page-title">
        {t(dict, 'chat.pageTitle')} {t(dict, 'chat.pageTitleHighlight')}
        <ToolHelp client:idle dict={clientDict} prefix="chat" sections={chatHelpSections} />
      </h1>
      <p class="page-lead">{t(dict, 'chat.pageSubtitle')}</p>
    </header>
    <div class="panel">
      <ChatCreate client:idle locale={locale} dict={clientDict} />
    </div>
    <details class="more mt-6">
      <summary>{t(dict, 'chat.howItWorks')}</summary>
      <ol class="steps more__body">
        <li>{t(dict, 'chat.howStep1')}</li>
        <li>{t(dict, 'chat.howStep2')}</li>
        <li>{t(dict, 'chat.howStep3')}</li>
      </ol>
    </details>
  </div>
</Layout>
