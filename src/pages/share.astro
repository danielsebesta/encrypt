---
import Layout from '../layouts/Layout.astro';
import UltimateEncrypt from '../components/tools/UltimateEncrypt.svelte';
import { getTranslations, t, pickDict, type Locale } from '../lib/i18n';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const dict = getTranslations(locale);
const encryptDict = pickDict(dict, ['tools.ultimateEncrypt', 'common']);

export const prerender = true;
---

<Layout
  title={t(dict, 'share.meta.title')}
  description={t(dict, 'share.meta.description')}
>
  <div class="page">
    <header class="page-head">
      <h1 class="page-title">{t(dict, 'landing.paths.share.title')}</h1>
      <p class="page-lead">{t(dict, 'landing.paths.share.text')}</p>
    </header>
    <div class="panel">
      <UltimateEncrypt client:idle locale={locale} dict={encryptDict} />
    </div>
  </div>
</Layout>
