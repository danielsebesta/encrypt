---
import Layout from '../../layouts/Layout.astro';
import Whiteboard from '../../components/tools/Whiteboard.svelte';
import { getTranslations, t, pickDict, type Locale } from '../../lib/i18n';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const dict = getTranslations(locale);
const clientDict = pickDict(dict, ['whiteboard', 'common']);
const { id } = Astro.params;

export const prerender = false;
---

<Layout
  title={t(dict, 'whiteboard.meta.roomTitle')}
  description={t(dict, 'whiteboard.meta.roomDescription')}
>
  <div class="page page--wide pt-5 pb-8 md:pt-6">
    <h1 class="section-title mb-3">{t(dict, 'whiteboard.pageTitle')} {t(dict, 'whiteboard.pageTitleHighlight')}</h1>
    <Whiteboard client:idle roomId={id || 'default'} locale={locale} dict={clientDict} />
  </div>
</Layout>
