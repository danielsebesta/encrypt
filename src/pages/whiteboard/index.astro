---
import Layout from '../../layouts/Layout.astro';
import WhiteboardCreate from '../../components/tools/WhiteboardCreate.svelte';
import { getTranslations, t, pickDict, type Locale } from '../../lib/i18n';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const dict = getTranslations(locale);
const clientDict = pickDict(dict, ['whiteboard', 'common']);

export const prerender = true;
---

<Layout
  title={t(dict, 'whiteboard.meta.createTitle')}
  description={t(dict, 'whiteboard.meta.createDescription')}
>
  <div class="page page--narrow">
    <header class="page-head">
      <h1 class="page-title">{t(dict, 'whiteboard.pageTitle')}</h1>
      <p class="page-lead">{t(dict, 'whiteboard.pageSubtitle')}</p>
    </header>
    <div class="panel">
      <WhiteboardCreate client:idle locale={locale} dict={clientDict} />
    </div>
    <details class="more mt-6">
      <summary>{t(dict, 'whiteboard.howItWorks')}</summary>
      <ol class="steps more__body">
        <li>{t(dict, 'whiteboard.howStep1')}</li>
        <li>{t(dict, 'whiteboard.howStep2')}</li>
        <li>{t(dict, 'whiteboard.howStep3')}</li>
      </ol>
    </details>
  </div>
</Layout>
