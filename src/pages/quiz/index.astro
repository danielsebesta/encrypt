---
import Layout from '../../layouts/Layout.astro';
import QuizCreate from '../../components/tools/QuizCreate.svelte';
import { getTranslations, t, type Locale } from '../../lib/i18n';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const dict = getTranslations(locale);

export const prerender = true;
---

<Layout
  title={t(dict, 'quiz.meta.createTitle')}
  description={t(dict, 'quiz.meta.createDescription')}
>
  <div class="max-w-2xl mx-auto px-5 py-12 md:py-20">
    <div class="mb-8 space-y-3 text-center">
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight">
        {t(dict, 'quiz.pageTitle')} <span class="text-emerald-500">{t(dict, 'quiz.pageTitleHighlight')}</span>
      </h1>
      <p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed max-w-md mx-auto">
        {t(dict, 'quiz.pageSubtitle')}
      </p>
    </div>
    <QuizCreate client:load locale={locale} />
  </div>
</Layout>
