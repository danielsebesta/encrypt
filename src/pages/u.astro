---
import Layout from '../layouts/Layout.astro';
import UltimateDecrypt from '../components/tools/UltimateDecrypt.svelte';
import { getTranslations, t, pickDict, type Locale } from '../lib/i18n';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const dict = getTranslations(locale);
const clientDict = pickDict(dict, ['tools.ultimateDecrypt', 'decryptPage', 'common']);

export const prerender = true;
---

<Layout
  title={t(dict, 'decryptPage.meta.title')}
  description={t(dict, 'decryptPage.meta.description')}
  canonical="https://encrypt.click/u"
>
  <div class="page">
    <header class="page-head page-head--art">
      <div>
        <h1 class="page-title">{t(dict, 'decryptPage.h1')}</h1>
        <p class="page-lead">{t(dict, 'decryptPage.subtitle')}</p>
      </div>
      <img src="/encrypt_magnify.svg" alt="" width="78" height="133" class="page-head__art" decoding="async" />
    </header>
    <div class="panel">
      <UltimateDecrypt client:idle locale={locale} dict={clientDict} />
    </div>
  </div>
</Layout>
