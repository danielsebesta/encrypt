---
import Layout from '../layouts/Layout.astro';
import DecryptForm from '../components/tools/DecryptForm.svelte';
import { getTranslations, t, pickDict, type Locale } from '../lib/i18n';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const dict = getTranslations(locale);
const clientDict = pickDict(dict, ['tools.decryptForm', 'decryptPage', 'shareLink', 'common', 'keys.error', 'keys.contact', 'keys.fingerprint'], ['keys.me.passwordLabel']);

export const prerender = true;
---

<Layout
  title={t(dict, 'decryptPage.meta.title')}
  description={t(dict, 'decryptPage.meta.description')}
>
  <div class="page">
    <header class="page-head">
      <h1 class="page-title">{t(dict, 'decryptPage.h1')}</h1>
      <p class="page-lead">{t(dict, 'decryptPage.subtitle')}</p>
    </header>
    <div class="panel">
      <DecryptForm client:idle locale={locale} dict={clientDict} />
    </div>
  </div>
</Layout>
