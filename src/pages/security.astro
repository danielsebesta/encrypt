---
import Layout from '../layouts/Layout.astro';
import { getTranslations, t, type Locale } from '../lib/i18n';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const dict = getTranslations(locale);

const sections: { title: string; paragraphs?: string[]; list?: string[] }[] = [
  { title: 'security.noAccounts.title', paragraphs: ['security.noAccounts.text'] },
  { title: 'security.clientSide.title', paragraphs: ['security.clientSide.p1', 'security.clientSide.p2'] },
  { title: 'security.share.title', paragraphs: ['security.share.p1', 'security.share.p2', 'security.share.p3'] },
  { title: 'security.chat.title', paragraphs: ['security.chat.p1', 'security.chat.p2', 'security.chat.p3', 'security.chat.p4', 'security.chat.p5', 'security.chat.p6'] },
  { title: 'security.shortening.title', paragraphs: ['security.shortening.p1', 'security.shortening.p2', 'security.shortening.p3'] },
  { title: 'security.cookies.title', paragraphs: ['security.cookies.p1', 'security.cookies.p2'] },
  { title: 'security.network.title', list: ['security.network.li1', 'security.network.li2', 'security.network.li3', 'security.network.li4', 'security.network.li5'] },
  { title: 'security.thirdParty.title', paragraphs: ['security.thirdParty.p1', 'security.thirdParty.p2'] },
  { title: 'security.disclosure.title', paragraphs: ['security.disclosure.text'] },
  { title: 'security.nonLegal.title', paragraphs: ['security.nonLegal.text'] },
];
---

<Layout
  title={t(dict, 'security.meta.title')}
  description={t(dict, 'security.meta.description')}
>
  <article class="page article">
    <header class="page-head page-head--art">
      <div>
        <h1 class="page-title">{t(dict, 'security.h1')}</h1>
        <p class="page-lead">{t(dict, 'security.subtitle')}</p>
      </div>
      <img src="/encrypt_shield.svg" alt="" width="154" height="128" class="page-head__art" decoding="async" />
    </header>
    {sections.map((s) => (
      <section>
        <h2>{t(dict, s.title)}</h2>
        {s.paragraphs?.map((p) => <p>{t(dict, p)}</p>)}
        {s.list && <ul>{s.list.map((li) => <li>{t(dict, li)}</li>)}</ul>}
      </section>
    ))}
  </article>
</Layout>
