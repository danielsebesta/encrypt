---
import AsciiDecode from '../components/AsciiDecode.svelte';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import HomeTry from '../components/home/HomeTry.svelte';
import HomeTools from '../components/home/HomeTools.astro';
import { REPO_URL } from '../lib/repo';
import { getTranslations, t, pickDict, type Locale } from '../lib/i18n';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const dict = getTranslations(locale);
const localePrefix = locale === 'en' ? '' : `/${locale}`;
const tryDict = pickDict(dict, ['tools.ultimateEncrypt', 'shareLink', 'common', 'chat', 'whiteboard', 'rooms', 'nav', 'landing']);

const facts = [1, 2, 3];
const steps = [1, 2, 3];
const deviceItems = [1, 2, 3];
const serverItems = [1, 2, 3];
---

<Layout title={t(dict, 'meta.defaultTitle')} description={t(dict, 'meta.defaultDescription')}>
  <div class="page home">
    <section class="home-hero" aria-labelledby="home-hero-title">
      <div class="home-hero__copy">
        <h1 id="home-hero-title" class="page-title">{t(dict, 'home.hero.title')}</h1>
        <p class="page-lead">{t(dict, 'landing.hero.subtitle')}</p>
        <ul class="home-facts">
          {facts.map((n) => (
            <li>
              <span class="home-facts__value"><AsciiDecode client:visible text={t(dict, `home.facts.${n}.value`)} scramble /></span>
              <span>{t(dict, `home.facts.${n}.label`)}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="home-hero__form" id="try">
        <HomeTry client:visible locale={locale} dict={tryDict} />
      </div>
    </section>

    <section aria-labelledby="home-trust-title">
      <div class="home-section__head">
        <h2 id="home-trust-title" class="section-title">{t(dict, 'home.trust.title')}</h2>
        <p class="hint">{t(dict, 'home.trust.lead')}</p>
      </div>
      <div class="home-trust__grid">
        <div class="home-trust__col">
          <h3 class="home-trust__title">{t(dict, 'home.trust.device.title')}</h3>
          <ul class="home-trust__list">
            {deviceItems.map((n) => (
              <li>
                <Icon name="lock-keyhole" />
                <span>{t(dict, `home.trust.device.${n}`)}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="home-trust__col">
          <h3 class="home-trust__title">{t(dict, 'home.trust.server.title')}</h3>
          <ul class="home-trust__list">
            {serverItems.map((n) => (
              <li>
                <Icon name="database-x" />
                <span>{t(dict, `home.trust.server.${n}`)}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="home-trust__foot">
        <p>{t(dict, 'home.trust.expiry')}</p>
        <a href={`${localePrefix}/security`}>{t(dict, 'landing.about.security')}</a>
        <a href={REPO_URL} target="_blank" rel="noopener noreferrer">{t(dict, 'landing.about.github')}<Icon name="arrow-up-right" /></a>
      </div>
    </section>

    <section aria-labelledby="home-how-title">
      <div class="home-section__head">
        <h2 id="home-how-title" class="section-title">{t(dict, 'landing.how.title')}</h2>
      </div>
      <ol class="home-steps">
        {steps.map((n) => (
          <li class="home-step">
            <span class="home-step__num" aria-hidden="true">{String(n).padStart(2, '0')}</span>
            <h3 class="home-card__title">{t(dict, `landing.how.${n}.title`)}</h3>
            <p class="hint">{t(dict, `landing.how.${n}.text`)}</p>
          </li>
        ))}
      </ol>
    </section>

    <HomeTools locale={locale} dict={dict} />

    <section class="home-app" aria-labelledby="home-app-title">
      <div class="home-app__copy">
        <h2 id="home-app-title" class="section-title">{t(dict, 'pwa.promo.title')}</h2>
        <p class="home-app__text">{t(dict, 'pwa.promo.text')}</p>
        <ul class="platform-pills" aria-label={t(dict, 'pwa.platforms.label')}>
          <li class="platform-pill">{t(dict, 'pwa.platforms.ios')}</li>
          <li class="platform-pill">{t(dict, 'pwa.platforms.android')}</li>
        </ul>
      </div>
      <div class="actions">
        <a href={`${localePrefix}/install`} class="btn-secondary">{t(dict, 'pwa.promo.how')}</a>
      </div>
    </section>
  </div>
</Layout>
