---
import Layout from '../layouts/Layout.astro';
import AppShowcase from '../components/AppShowcase.astro';
import Icon from '../components/Icon.astro';
import HomeQuickStart from '../components/home/HomeQuickStart.svelte';
import { tools } from '../lib/tools';
import { getTranslations, t, pickDict, type Locale } from '../lib/i18n';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const dict = getTranslations(locale);
const tryDict = pickDict(dict, ['tools.shareForm', 'shareLink', 'common', 'chat', 'whiteboard', 'rooms', 'nav', 'landing', 'keys.error', 'keys.contact', 'keys.fingerprint'], ['keys.me.passwordLabel']);

const sentences = (key: string) => t(dict, key).split(/(?<=[.!?])\s+/).map((line) => (line.split(/\s+/).length > 3 ? line.replace(/\s+(\S+)$/, '\u00a0$1') : line));
const tagline = sentences('home.tagline.1');
const lead = sentences('landing.hero.subtitle');
const heroPoints = [[1, 'shield-keyhole', null], [2, 'key', null], [3, 'file-lock', null]] as const;
const stack = ['AES-256-GCM', 'ECDH P-256', 'ML-KEM-768', 'Ed25519', 'Argon2id', 'HKDF', 'drand'];
const uses = [
  [1, 'upload', '/share'],
  [2, 'message-circle', '/chat'],
  [3, 'presentation', '/whiteboard'],
] as const;
const appPerks = [['fingerprint-pattern', 1], ['bookmark', 2], ['share', 3]] as const;
const toolLinks = tools.map((tool) => ({
  label: t(dict, tool.navLabelKey),
  href: `/tools/${tool.slug}`,
  icon: tool.icon,
}));
---

<Layout title={t(dict, 'meta.defaultTitle')} description={t(dict, 'meta.defaultDescription')} background="classic">
  <div class="page home">
    <section class="home-hero" aria-labelledby="home-hero-title">
      <div class="home-hero__copy">
        <h1 id="home-hero-title" class="page-title home-hero__title">{tagline.map((line) => <span class="block">{line}</span>)}</h1>
        <p class="page-lead">{lead.map((line) => <span class="block">{line}</span>)}</p>
        <ul class="home-hero__points">
          {heroPoints.map(([n, icon, href]) => (
            <li>
              <Icon name={icon} size={20} />
              {href ? <a href={href}>{t(dict, `home.hero.point.${n}`)}</a> : <span>{t(dict, `home.hero.point.${n}`)}</span>}
            </li>
          ))}
        </ul>
        <div class="home-hero__stack">
          <p class="home-hero__stack-label">{t(dict, 'home.hero.stack')}</p>
          <ul class="home-hero__stack-list">
            {stack.map((name) => <li>{name}</li>)}
          </ul>
        </div>
      </div>
      <div class="home-hero__form panel" id="try">
        <HomeQuickStart client:visible locale={locale} dict={tryDict} />
      </div>
    </section>

    <section class="home-uses" aria-labelledby="home-uses-title">
      <h2 id="home-uses-title" class="home-uses__lead">{t(dict, 'home.uses.lead')}</h2>
      <ul class="home-uses__list">
        {uses.map(([n, icon, href]) => (
          <li>
            <a href={href} class="home-uses__link">
              <Icon name={icon} size={20} />
              <span>{t(dict, `home.uses.${n}`)}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="home-app" aria-labelledby="home-app-title">
      <div class="home-app__copy">
        <h2 id="home-app-title" class="section-title">{t(dict, 'pwa.promo.title')}</h2>
        <p class="hint">{t(dict, 'pwa.promo.lead')}</p>
        <ul class="home-app__perks home-app__perks--start">
          {appPerks.map(([icon, n]) => (
            <li><Icon name={icon} />{t(dict, `pwa.feature.${n}.title`)}</li>
          ))}
        </ul>
        <div class="actions">
          <a class="btn" href="/install"><Icon name="download" />{t(dict, 'home.footer.install')}</a>
          <a class="btn-ghost" href="/install">{t(dict, 'pwa.promo.how')}</a>
        </div>
      </div>
      <AppShowcase class="home-app__showcase" />
    </section>

    <section class="home-tools" aria-labelledby="home-tools-title">
      <div class="home-tools__copy">
        <h2 id="home-tools-title" class="section-title">{t(dict, 'home.tools.title')}</h2>
        <p class="hint">{t(dict, 'home.tools.subtitle')}</p>
      </div>
      <ul class="home-tools__list">
        {toolLinks.map((tool) => (
          <li>
            <a href={tool.href} class="home-tools__link">
              <Icon name={tool.icon} size={20} />
              <span>{tool.label}</span>
              <Icon name="arrow-right" class="home-tools__arrow" />
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Layout>
