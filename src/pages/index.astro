---
import Layout from '../layouts/Layout.astro';
import AppShowcase from '../components/AppShowcase.astro';
import Icon from '../components/Icon.astro';
import HomeTry from '../components/home/HomeTry.svelte';
import HomeTools from '../components/home/HomeTools.astro';
import HomeBento from '../components/home/HomeBento.astro';
import AppQr from '../components/home/AppQr.svelte';
import { REPO_URL } from '../lib/repo';
import { getTranslations, t, pickDict, type Locale } from '../lib/i18n';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const dict = getTranslations(locale);
const tryDict = pickDict(dict, ['tools.ultimateEncrypt', 'shareLink', 'common', 'chat', 'whiteboard', 'rooms', 'nav', 'landing']);

const steps = [[1, 'file-lock'], [2, 'link'], [3, 'lock-open']] as const;
const deviceItems = [[1, 'file-text'], [2, 'key'], [3, 'shield-keyhole']] as const;
const appFeatures = [['fingerprint-pattern', 1], ['bookmark', 2], ['share', 3], ['download', 4]] as const;
const serverItems = [[1, 'file-lock'], [2, 'clock'], [3, 'globe']] as const;
const retention = ['retention1h', 'retention1d', 'retention7d'];
const sentences = (key: string) => t(dict, key).split(/(?<=[.!?])\s+/).map((line) => (line.split(/\s+/).length > 3 ? line.replace(/\s+(\S+)$/, '\u00a0$1') : line));
const tagline = sentences('home.tagline.1');
const lead = sentences('landing.hero.subtitle');
---

<Layout title={t(dict, 'meta.defaultTitle')} description={t(dict, 'meta.defaultDescription')} background="classic">
  <div class="page home">
    <section class="home-hero" aria-labelledby="home-hero-title">
      <div class="home-hero__copy">
        <h1 id="home-hero-title" class="page-title home-hero__title">{tagline.map((line) => <span class="block">{line}</span>)}</h1>
        <p class="page-lead">{lead.map((line) => <span class="block">{line}</span>)}</p>
      </div>
      <div class="home-hero__form panel" id="try">
        <HomeTry client:visible locale={locale} dict={tryDict} />
      </div>
    </section>

    <section aria-labelledby="home-trust-title">
      <div class="home-section__head">
        <h2 id="home-trust-title" class="section-title">{t(dict, 'home.trust.title')}</h2>
        <p class="hint">{t(dict, 'home.trust.lead')}</p>
      </div>
      <div class="home-flow">
        <div class="home-flow__side home-flow__side--device panel panel--flush">
          <div class="home-flow__head">
            <span class="icon-tile icon-tile--accent"><Icon name="lock-keyhole" size={20} /></span>
            <div>
              <h3 class="home-flow__title">{t(dict, 'home.trust.device.title')}</h3>
              <p class="home-flow__note">{t(dict, 'home.trust.device.note')}</p>
            </div>
          </div>
          <ul class="home-flow__list">
            {deviceItems.map(([n, icon]) => (
              <li><span class="home-flow__icon"><Icon name={icon} /></span><span>{t(dict, `home.trust.device.${n}`)}</span></li>
            ))}
          </ul>
        </div>
        <div class="home-flow__bridge">
          <span class="home-flow__line" aria-hidden="true"></span>
          <div class="home-flow__label">
            <Icon name="lock" />
            <span>{t(dict, 'home.trust.bridge')}</span>
            <span class="badge badge--mono">AES-GCM</span>
          </div>
          <span class="home-flow__line" aria-hidden="true"></span>
          <span class="home-flow__arrow" aria-hidden="true"><Icon name="chevron-down" class="md:hidden" /><Icon name="chevron-right" class="hidden md:block" /></span>
        </div>
        <div class="home-flow__side home-flow__side--server panel panel--flush">
          <div class="home-flow__head">
            <span class="icon-tile"><Icon name="cloud" size={20} /></span>
            <div>
              <h3 class="home-flow__title">{t(dict, 'home.trust.server.title')}</h3>
              <p class="home-flow__note">{t(dict, 'home.trust.server.note')}</p>
            </div>
          </div>
          <ul class="home-flow__list">
            {serverItems.map(([n, icon]) => (
              <li><span class="home-flow__icon"><Icon name={icon} /></span><span>{t(dict, `home.trust.server.${n}`)}</span></li>
            ))}
          </ul>
        </div>
      </div>
      <div class="home-expiry panel panel--flush">
        <div class="home-flow__head home-expiry__head">
          <span class="icon-tile"><Icon name="timer" size={20} /></span>
          <div>
            <h3 class="home-flow__title">{t(dict, 'home.trust.expiryTitle')}</h3>
            <p class="home-flow__note">{t(dict, 'home.trust.expiryLead')}</p>
          </div>
        </div>
        <ul class="home-expiry__chips">
          {retention.map((key) => (
            <li class="badge">{t(dict, `tools.ultimateEncrypt.options.${key}`)}</li>
          ))}
          <li class="badge badge--warn"><Icon name="flame" />{t(dict, 'tools.ultimateEncrypt.options.burn')}</li>
        </ul>
        <p class="home-expiry__inline"><Icon name="link" /><span>{t(dict, 'home.trust.inline')}</span></p>
      </div>
      <div class="home-trust__links">
        <a class="btn-secondary btn-sm" href="/security"><Icon name="shield-check" />{t(dict, 'landing.about.security')}</a>
        <a class="btn-ghost btn-sm" href={REPO_URL} target="_blank" rel="noopener noreferrer"><Icon name="github" />{t(dict, 'landing.about.github')}<Icon name="arrow-up-right" /></a>
      </div>
    </section>

    <section aria-labelledby="home-how-title">
      <div class="home-section__head">
        <h2 id="home-how-title" class="section-title">{t(dict, 'landing.how.title')}</h2>
      </div>
      <ol class="home-steps">
        {steps.map(([n, icon]) => (
          <li class="home-step panel">
            <div class="home-step__top">
              <span class="home-step__num" aria-hidden="true">{String(n).padStart(2, '0')}</span>
              <span class="icon-tile"><Icon name={icon} size={20} /></span>
            </div>
            <h3 class="home-card__title">{t(dict, `landing.how.${n}.title`)}</h3>
            <p class="home-step__text">{t(dict, `landing.how.${n}.text`)}</p>
          </li>
        ))}
      </ol>
    </section>

    <HomeBento dict={dict} />

    <HomeTools locale={locale} dict={dict} />

    <section class="home-app" aria-labelledby="home-app-title">
      <div class="home-app__head">
        <h2 id="home-app-title" class="home-app__title">{t(dict, 'pwa.promo.title')}</h2>
        <p class="page-lead">{t(dict, 'pwa.promo.lead')}</p>
        <ul class="home-app__perks">
          {appFeatures.map(([icon, n]) => (
            <li><Icon name={icon} />{t(dict, `pwa.feature.${n}.title`)}</li>
          ))}
        </ul>
        <button type="button" class="btn hidden" data-pwa-install>{t(dict, 'install.guide.button')}</button>
      </div>
      <AppShowcase class="home-app__showcase" />
      <div class="home-app__grid">
        <div class="home-app__card panel">
          <h3 id="home-app-ios" class="home-app__card-title"><Icon name="apple" size={20} />{t(dict, 'install.ios.title')}</h3>
          <p class="home-app__card-text">{t(dict, 'install.ios.2')}</p>
          <a href="/install#install-ios" id="home-app-ios-how" aria-labelledby="home-app-ios-how home-app-ios" class="btn-secondary btn-block">{t(dict, 'pwa.promo.how')}</a>
        </div>
        <div class="home-app__card panel">
          <h3 id="home-app-android" class="home-app__card-title"><Icon name="android" size={20} />{t(dict, 'install.android.title')}</h3>
          <p class="home-app__card-text">{t(dict, 'install.android.2')}</p>
          <a href="/install#install-android" id="home-app-android-how" aria-labelledby="home-app-android-how home-app-android" class="btn-secondary btn-block">{t(dict, 'pwa.promo.how')}</a>
        </div>
        <div class="home-app__card home-app__card--qr panel">
          <h3 class="home-app__card-title"><Icon name="qr-code" size={20} />{t(dict, 'pwa.promo.scan')}</h3>
          <p class="home-app__card-text">{t(dict, 'pwa.promo.scanText')}</p>
          <AppQr client:visible path="/install" alt={t(dict, 'install.guide.qrAlt')} />
        </div>
      </div>
    </section>
  </div>
</Layout>
