---
import Layout from '../../layouts/Layout.astro';
import { getTranslations, t, type Locale } from '../../lib/i18n';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const dict = getTranslations(locale);
const localePrefix = locale === 'en' ? '' : `/${locale}`;

export const prerender = true;

type Card = {
  href: string | null;
  icon: string;
  title: string;
  description: string;
  comingSoon?: boolean;
  betaSoon?: boolean;
};

const cards: Card[] = [
  {
    href: `${localePrefix}/whiteboard`,
    icon: '<rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>',
    title: t(dict, 'studio.tool.whiteboard.title'),
    description: t(dict, 'studio.tool.whiteboard.description'),
  },
  {
    href: `${localePrefix}/memo`,
    icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/>',
    title: t(dict, 'studio.tool.memo.title'),
    description: t(dict, 'studio.tool.memo.description'),
  },
  {
    href: `${localePrefix}/ledger`,
    icon: '<rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M3 15h18"/><path d="M9 3v18"/><path d="M15 3v18"/>',
    title: t(dict, 'studio.tool.ledger.title'),
    description: t(dict, 'studio.tool.ledger.description'),
  },
  {
    href: `${localePrefix}/deck`,
    icon: '<rect width="20" height="14" x="2" y="3" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/><circle cx="9" cy="10" r="1.5"/><path d="M14 13l-2-2-3 3"/>',
    title: t(dict, 'studio.tool.deck.title'),
    description: t(dict, 'studio.tool.deck.description'),
  },
];
---

<Layout
  title={t(dict, 'studio.meta.title')}
  description={t(dict, 'studio.meta.description')}
>
  <div class="max-w-5xl mx-auto px-5 py-12 md:py-20">
    <div class="text-center mb-12 space-y-3">
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight">
        {t(dict, 'studio.pageTitle')} <span class="text-emerald-500">{t(dict, 'studio.pageTitleHighlight')}</span>
      </h1>
      <p class="text-sm md:text-base text-zinc-500 dark:text-zinc-400 leading-relaxed max-w-xl mx-auto">
        {t(dict, 'studio.pageSubtitle')}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {cards.map((card) => (
        card.href ? (
          <a
            href={card.href}
            class="studio-card group"
          >
            <div class="studio-card-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={card.icon} />
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <h2 class="studio-card-title">{card.title}</h2>
                {card.betaSoon && (<span class="studio-beta-badge">{t(dict, 'studio.beta')}</span>)}
              </div>
              <p class="studio-card-desc">{card.description}</p>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="studio-card-arrow"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        ) : (
          <div class="studio-card studio-card--soon">
            <div class="studio-card-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={card.icon} />
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <h2 class="studio-card-title">{card.title}</h2>
                <span class="studio-soon-badge">{t(dict, 'studio.comingSoon')}</span>
              </div>
              <p class="studio-card-desc">{card.description}</p>
            </div>
          </div>
        )
      ))}
    </div>

    <p class="mt-8 text-xs text-center text-zinc-400 dark:text-zinc-500 leading-relaxed">
      {t(dict, 'studio.footer')}
    </p>
  </div>
</Layout>

<style>
  .studio-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border-radius: 0.85rem;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(228, 228, 231, 0.6);
    transition: transform 0.18s, border-color 0.18s, background 0.18s;
    text-decoration: none;
    color: inherit;
  }
  :global(.dark) .studio-card {
    background: rgba(24, 24, 27, 0.4);
    border-color: rgba(63, 63, 70, 0.4);
  }
  a.studio-card:hover {
    transform: translateY(-2px);
    border-color: rgba(16, 185, 129, 0.4);
    background: rgba(255, 255, 255, 0.95);
  }
  :global(.dark) a.studio-card:hover {
    background: rgba(24, 24, 27, 0.7);
  }
  .studio-card--soon {
    opacity: 0.55;
  }
  .studio-card-icon {
    flex-shrink: 0;
    width: 44px; height: 44px;
    border-radius: 0.6rem;
    display: flex; align-items: center; justify-content: center;
    background: rgba(16, 185, 129, 0.1);
    color: rgb(16, 185, 129);
  }
  .studio-card-title {
    font-size: 1rem;
    font-weight: 700;
    color: rgb(24, 24, 27);
    margin: 0;
  }
  :global(.dark) .studio-card-title { color: rgb(244, 244, 245); }
  .studio-card-desc {
    margin-top: 0.25rem;
    font-size: 0.8rem;
    color: rgb(113, 113, 122);
    line-height: 1.5;
  }
  :global(.dark) .studio-card-desc { color: rgb(161, 161, 170); }
  .studio-card-arrow {
    color: rgb(161, 161, 170);
    align-self: center;
    transition: transform 0.18s, color 0.18s;
  }
  .studio-card:hover .studio-card-arrow {
    color: rgb(16, 185, 129);
    transform: translateX(2px);
  }
  .studio-soon-badge,
  .studio-beta-badge {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: 4px;
  }
  .studio-soon-badge {
    background: rgba(245, 158, 11, 0.15);
    color: rgb(180, 83, 9);
  }
  :global(.dark) .studio-soon-badge {
    background: rgba(245, 158, 11, 0.18);
    color: rgb(251, 191, 36);
  }
  .studio-beta-badge {
    background: rgba(99, 102, 241, 0.15);
    color: rgb(79, 70, 229);
  }
  :global(.dark) .studio-beta-badge {
    background: rgba(99, 102, 241, 0.18);
    color: rgb(165, 180, 252);
  }
</style>
