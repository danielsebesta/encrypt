---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import InstallGuide from '../components/InstallGuide.svelte';
import { getTranslations, pickDict, t, type Locale } from '../lib/i18n';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const dict = getTranslations(locale);
const guideDict = pickDict(dict, ['install.guide', 'common.copy', 'common.copied', 'common.uploadChallenge.retry']);
const perks = [['fingerprint-pattern', 1], ['bookmark', 2], ['share', 3], ['download', 4]] as const;
const platforms = [
  { id: 'install-ios', icon: 'apple', prefix: 'install.ios' },
  { id: 'install-android', icon: 'android', prefix: 'install.android' },
] as const;

export const prerender = true;
---

<Layout
  title={t(dict, 'install.meta.title')}
  description={t(dict, 'install.meta.description')}
>
  <div class="page install-page">
    <header class="install-hero">
      <div class="install-hero__copy">
        <h1 class="page-title">{t(dict, 'install.h1')}</h1>
        <p class="page-lead">{t(dict, 'install.subtitle')}</p>
        <ul class="home-app__perks install-hero__perks">
          {perks.map(([icon, n]) => (
            <li><Icon name={icon} />{t(dict, `pwa.feature.${n}.title`)}</li>
          ))}
        </ul>
      </div>
      <img class="app-shot install-hero__shot" src="/screenshot-hub-chats.png?v=9" alt="" width="220" height="476" loading="eager" decoding="async" />
    </header>

    <InstallGuide client:load dict={guideDict} appHref="/app" />

    <section class="install-manual" aria-labelledby="install-manual-title">
      <h2 id="install-manual-title" class="section-title">{t(dict, 'install.manual.title')}</h2>
      <div class="install-guides">
        {platforms.map(({ id, icon, prefix }) => (
          <section class="install-guide panel" aria-labelledby={id}>
            <h3 id={id} class="install-guide__title">
              <span class="icon-tile"><Icon name={icon} size={20} /></span>
              {t(dict, `${prefix}.title`)}
            </h3>
            <ol class="install-steps">
              {[1, 2, 3].map((n) => <li>{t(dict, `${prefix}.${n}`)}</li>)}
            </ol>
          </section>
        ))}
      </div>
    </section>

    <nav class="install-more" aria-label={t(dict, 'install.more')}>
      <a href="/share" class="btn-secondary"><Icon name="lock" />{t(dict, 'install.cta.share')}</a>
      <a href="/u" class="btn-ghost"><Icon name="lock-open" />{t(dict, 'install.cta.decrypt')}</a>
    </nav>
  </div>
</Layout>
