---
import Layout from '../../layouts/Layout.astro';
import UUIDULIDView from '../../components/tools/UUIDULID.svelte';
import ToolAbout from '../../components/tools/ToolAbout.astro';
import { getTranslations, t, toolClientDict, type Locale } from '../../lib/i18n';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const dict = getTranslations(locale);
const clientDict = toolClientDict(dict, 'tools.uuidUlid');
---

<Layout
  title={t(dict, 'tools.uuidUlid.meta.title')}
  description={t(dict, 'tools.uuidUlid.meta.description')}
>
  <div class="page">
    <header class="page-head">
      <h1 class="page-title">{t(dict, 'tools.uuidUlid.h1')}</h1>
      <p class="page-lead">{t(dict, 'tools.uuidUlid.subtitle')}</p>
    </header>
    <div class="panel">
      <UUIDULIDView client:idle locale={locale} dict={clientDict} />
    </div>
    <ToolAbout dict={dict} prefix="tools.uuidUlid" />
  </div>
</Layout>
