---
import Layout from '../../layouts/Layout.astro';
import AESWordsView from '../../components/tools/AESWords.svelte';
import ToolHelp from '../../components/tools/ToolHelp.svelte';
import { getTranslations, t, toolClientDict, type Locale } from '../../lib/i18n';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const dict = getTranslations(locale);
const clientDict = toolClientDict(dict, 'tools.aesWords');
---

<Layout
  title={t(dict, 'tools.aesWords.meta.title')}
  description={t(dict, 'tools.aesWords.meta.description')}
>
  <div class="page">
    <header class="page-head">
      <h1 class="page-title">
        {t(dict, 'tools.aesWords.h1')} {t(dict, 'tools.aesWords.h1Highlight')}
        <ToolHelp client:idle dict={clientDict} prefix="tools.aesWords" />
      </h1>
      <p class="page-lead">{t(dict, 'tools.aesWords.subtitle')}</p>
    </header>
    <div class="panel">
      <AESWordsView client:idle locale={locale} dict={clientDict} />
    </div>
  </div>
</Layout>
