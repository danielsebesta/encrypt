---
import Layout from '../../layouts/Layout.astro';
import Base64View from '../../components/tools/Base64.svelte';
import ToolHelp from '../../components/tools/ToolHelp.svelte';
import { getTranslations, t, toolClientDict, type Locale } from '../../lib/i18n';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const dict = getTranslations(locale);
const clientDict = toolClientDict(dict, 'tools.base64');
---

<Layout
  title={t(dict, 'tools.base64.meta.title')}
  description={t(dict, 'tools.base64.meta.description')}
>
  <div class="page">
    <header class="page-head">
      <h1 class="page-title">
        {t(dict, 'tools.base64.h1')}
        <ToolHelp client:idle dict={clientDict} prefix="tools.base64" />
      </h1>
      <p class="page-lead">{t(dict, 'tools.base64.subtitle')}</p>
    </header>
    <div class="panel">
      <Base64View client:idle locale={locale} dict={clientDict} />
    </div>
  </div>
</Layout>
