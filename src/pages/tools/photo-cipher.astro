---
import Layout from '../../layouts/Layout.astro';
import PhotoCipherView from '../../components/tools/PhotoCipher.svelte';
import ToolHelp from '../../components/tools/ToolHelp.svelte';
import { getTranslations, t, toolClientDict, type Locale } from '../../lib/i18n';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const dict = getTranslations(locale);
const clientDict = toolClientDict(dict, 'tools.photoCipher');
---

<Layout
  title={t(dict, 'tools.photoCipher.meta.title')}
  description={t(dict, 'tools.photoCipher.meta.description')}
>
  <div class="max-w-4xl mx-auto px-5 py-12 md:py-20">
    <div class="tool-hero">
      <div class="tool-hero__copy">
        <h1 class="tool-hero__title">
          {t(dict, 'tools.photoCipher.h1')} <span class="text-emerald-500">{t(dict, 'tools.photoCipher.h1Highlight')}</span>
          <ToolHelp client:idle dict={clientDict} prefix="tools.photoCipher" />
        </h1>
        <p class="tool-hero__subtitle">{t(dict, 'tools.photoCipher.subtitle')}</p>
      </div>
    </div>
    <div class="mt-8">
      <PhotoCipherView client:idle locale={locale} dict={clientDict} />
    </div>
  </div>
</Layout>
