{
  "name": "encrypt-click",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/generate-integrity-manifest.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "partykit:dev": "node --env-file-if-exists=.env.local ./node_modules/partykit/dist/bin.mjs dev",
    "partykit:deploy": "node --env-file-if-exists=.env.local ./node_modules/partykit/dist/bin.mjs deploy",
    "partykit:list": "node --env-file-if-exists=.env.local ./node_modules/partykit/dist/bin.mjs list",
    "partykit:whoami": "node --env-file-if-exists=.env.local ./node_modules/partykit/dist/bin.mjs whoami"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/svelte": "^7.2.5",
    "@tailwindcss/vite": "^4.2.4",
    "astro": "^5.18.1",
    "drand-client": "^1.4.2",
    "hash-wasm": "^4.12.0",
    "jwt-decode": "^4.0.0",
    "lz-string": "^1.5.0",
    "openpgp": "^6.3.0",
    "partykit": "^0.0.115",
    "partysocket": "^1.1.18",
    "perfect-freehand": "^1.2.3",
    "qrcode": "^1.5.4",
    "svelte": "^5.55.5",
    "tailwindcss": "^4.2.4",
    "tlock-js": "^0.9.0",
    "ulid": "^3.0.2",
    "yjs": "^13.6.30"
  },
  "packageManager": "pnpm@10.33.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "wrangler": "^4.88.0"
  }
}
