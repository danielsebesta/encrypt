{
  "name": "encrypt-click",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "check": "astro check",
    "audit:security": "pnpm audit --audit-level=moderate",
    "dev": "astro dev",
    "dev:worker": "npm run build && wrangler dev --config dist/server/wrangler.json",
    "build": "astro build && node scripts/inject-csp-hashes.mjs && node scripts/generate-integrity-manifest.mjs && node scripts/merge-wrangler-routes.mjs",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "build:node": "node scripts/build-node.mjs",
    "start:node": "node dist/node/server.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/node": "^11.1.9",
    "@astrojs/svelte": "^9.0.1",
    "@quickdrawjs/core": "0.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.6",
    "drand-client": "^1.4.2",
    "hash-wasm": "^4.12.0",
    "jwt-decode": "^4.0.0",
    "lz-string": "^1.5.0",
    "openpgp": "^6.3.2",
    "partyserver": "0.5.10",
    "partysocket": "^1.3.0",
    "qrcode": "^1.5.4",
    "svelte": "^5.57.2",
    "tailwindcss": "^4.3.3",
    "tlock-js": "^0.9.0",
    "ulid": "^3.0.2",
    "ws": "8.22.0",
    "yjs": "^13.6.33"
  },
  "packageManager": "pnpm@10.33.3",
  "pnpm": {
    "overrides": {
      "@fastify/busboy": "3.2.2",
      "sharp": "0.35.5"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ],
    "patchedDependencies": {
      "@quickdrawjs/core": "patches/@quickdrawjs__core.patch"
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.3",
    "wrangler": "^4.148.0"
  }
}
